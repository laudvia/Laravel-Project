<?php

use Illuminate\Support\Facades\Route;
use App\Http\Controllers\MainController;

use App\Http\Controllers\ArticleCommentController;

use App\Http\Controllers\NotificationController;

/*
|--------------------------------------------------------------------------
| Web Routes
|--------------------------------------------------------------------------
| В ЛР15 приложение переведено в формат REST API.
| Все основные маршруты перенесены в routes/api.php и доступны по префиксу /api.
| Здесь оставлены только демонстрационные страницы (если нужны для UI).
*/

Route::get('/', [MainController::class, 'index']);

Route::get('/about', function () {
    return view('main/about');
});

Route::get('/contact', function () {
    $contact = [
        'name' => 'Polytech',
        'adress' => 'B.Semenovskaya',
        'phone' => '8(495) 423-2323',
        'email' => '@mospolythech.ru'
    ];

    return view('main/contact', ['contact' => $contact]);
});

Route::get('/galery/{full_image}', [MainController::class, 'show']);

// --- Articles (WEB UI) ---
use App\Http\Controllers\ArticleController;

Route::get('/articles', [ArticleController::class, 'index'])->name('articles.index');
Route::get('/articles/create', [ArticleController::class, 'create'])->name('articles.create');
Route::post('/articles', [ArticleController::class, 'store'])->name('articles.store');
Route::get('/articles/{article}', [ArticleController::class, 'show'])->name('articles.show');
Route::get('/articles/{article}/edit', [ArticleController::class, 'edit'])->name('articles.edit');
Route::put('/articles/{article}', [ArticleController::class, 'update'])->name('articles.update');
Route::delete('/articles/{article}', [ArticleController::class, 'destroy'])->name('articles.destroy');


// --- Auth pages (WEB) to test API ---
Route::view("/login", "auth.login")->name("login");
Route::view("/register", "auth.register")->name("register.form");
Route::post("/logout", function () {
    return redirect("/")->with("success", "Logout: use API POST /api/logout with Bearer token.");
})->name("logout");


use App\Http\Controllers\WebAuthController;

Route::post('/login', [WebAuthController::class, 'login'])->name('login.perform');

Route::post('/register', [WebAuthController::class, 'register'])->name('register.perform');

// --- Auth (WEB session) ---
Route::post('/logout', [WebAuthController::class, 'logout'])->name('logout');

// --- Notifications (WEB) ---
Route::get('/notifications/{id}', [NotificationController::class, 'open'])
    ->middleware('auth')
    ->name('notifications.open');

// --- Article Comments (WEB) ---
Route::get('/articles/{article}/comments', [ArticleCommentController::class, 'index'])
    ->name('articles.comments.index');

Route::post('/articles/{article}/comments', [ArticleCommentController::class, 'store'])
    ->middleware('auth')
    ->name('articles.comments.store');

// --- Debug: who am I (WEB session) ---
Route::get('/whoami', function () {
    return response()->json([
        'is_auth' => auth()->check(),
        'user' => auth()->user(),
        'session_id' => session()->getId(),
    ]);
})->name('whoami');


// --- COMMENTS + MODERATION (WEB) ---

use App\Http\Controllers\WebArticleCommentController;
use App\Http\Controllers\ModeratorCommentController;

Route::middleware(['web'])->group(function () {
    // comments (WEB)
    Route::get('/articles/{article}/comments', [WebArticleCommentController::class, 'index'])
        ->name('articles.comments.index');
    Route::post('/articles/{article}/comments', [WebArticleCommentController::class, 'store'])
        ->middleware('auth')
        ->name('articles.comments.store');

    // moderator comments
    Route::prefix('moderator')->middleware(['auth'])->group(function () {
        Route::get('/comments', [ModeratorCommentController::class, 'index'])
            ->middleware('can:is-moderator')
            ->name('moderator.comments.index');

        Route::patch('/comments/{comment}/approve', [ModeratorCommentController::class, 'approve'])
            ->middleware('can:is-moderator')
            ->name('moderator.comments.approve');

        Route::delete('/comments/{comment}/reject', [ModeratorCommentController::class, 'reject'])
            ->middleware('can:is-moderator')
            ->name('moderator.comments.reject');
    });
});
